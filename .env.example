# ── Site URL ──────────────────────────────────────────────────
# Used for sitemap.xml and Open Graph metadata
# Ganti dengan domain Vercel Anda setelah deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Admin Auth ──────────────────────────────────────────────
# In-memory admin credentials (local JSON mode only).
# On Vercel/Supabase, auth is handled by Supabase Auth.
ADMIN_EMAIL=admin@sekolah.sch.id
ADMIN_PASSWORD=change-this-password

# Session secret for JWT cookie (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=dev-secret-change-in-production-min-32-chars!

# ── Data Provider ──────────────────────────────────────────
# "json"  → local filesystem (data/*.json) — works only in dev
# "supabase" → Supabase PostgreSQL — required on Vercel
# Defaults: "json" locally, "supabase" on Vercel (auto-detected)
# DATABASE_PROVIDER=supabase

# ── Supabase (required for Vercel) ──────────────────────────
# Isi dengan credentials dari project Supabase Anda
# Settings → API → Project URL + anon public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
